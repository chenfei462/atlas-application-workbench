# Browser/build public settings. Required for production npm run build; leave blank here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server/CLI production identity. The hosting platform must also be chosen explicitly.
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server/CLI only. Never prefix these with VITE_ or expose them in browser code.
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
SUPABASE_DB_SSL_ROOT_CERT=

# Absolute path to matching PostgreSQL client binaries, if they are not on PATH.
ATLAS_PG_BIN_DIR=
FRONTEND_HOSTING_PLATFORM=
